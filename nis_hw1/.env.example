# Шаблон для .env (cp .env.example .env)
# Файл .env не попадает в git, без него берутся значения из docker-compose.yml

POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=subscriptions

API_PORT=8000

# Часовой пояс, по которому определяется «сегодня»
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Нужен только при запуске без Docker
# DATABASE_URL=postgresql+psycopg://tracker:change-me@localhost:5432/subscriptions
